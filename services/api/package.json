{
  "name": "@indus/api",
  "version": "0.1.0",
  "private": true,
  "description": "Node 20 + Express + TypeScript API for Indus ERP. Owner: Orion.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
