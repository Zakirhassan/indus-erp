# Indus ERP — environment configuration
#
# Copy this file to `.env` for local development:
#   cp .env.example .env      (bash)
#   Copy-Item .env.example .env   (PowerShell)
#
# `npm run dev:up` reads `.env` (once services consume it via @indus/config).
# Everything below the "REPLACE AT DEPLOY" marker is NOT needed for local
# dev — leave it blank/commented until an actual deploy pipeline needs it.

# --- Core app ---

# Port the API listens on locally.
PORT=3000

# --- Database ---

# Matches the fixed local dev credentials in docker-compose.yml
# (service: postgres, db: indus_erp, user: indus).
DATABASE_URL=postgresql://indus:indus_dev_password@localhost:5432/indus_erp

# --- Auth / secrets (local dev only — generate real random secrets per env) ---

# HS256 signing secret for short-lived access tokens.
JWT_ACCESS_SECRET=dev_access_secret_change_me

# HS256 signing secret for longer-lived refresh tokens. Must differ from
# JWT_ACCESS_SECRET so a leaked access secret can't be used to mint refresh
# tokens.
JWT_REFRESH_SECRET=dev_refresh_secret_change_me

# Symmetric key used to encrypt Aadhaar numbers (and other sensitive PII) at
# rest in Postgres. 32-byte key, base64 or hex encoded — see @indus/auth
# once implemented for the expected format.
AADHAAR_ENCRYPTION_KEY=dev_aadhaar_encryption_key_change_me

# --- REPLACE AT DEPLOY (not needed for local dev) ---
# Local dev never talks to real cloud services — Postgres runs in Docker and
# there's no object storage / SMS / cloud provider needed to run `npm run
# dev:up`. These are placeholders for staging/production deploys (Vulcan
# wires the real values into the deploy pipeline's secret store, not into a
# committed .env).

# --- Object storage (photos of items, signed agreements, ID proofs, etc) ---
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=

# --- SMS (collection reminders / OTPs) ---
# SMS_PROVIDER=
# SMS_API_KEY=
# SMS_SENDER_ID=

# --- Cloud provider (AWS) ---
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
