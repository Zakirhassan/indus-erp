{
  "name": "@indus/db",
  "version": "0.1.0",
  "private": true,
  "description": "Postgres schema (Drizzle ORM), migrations, seed data, and query functions for Indus ERP.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@indus/auth": "*",
    "@indus/config": "*",
    "@indus/shared-types": "*",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.1"
  }
}
