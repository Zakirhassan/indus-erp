{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-native",
    "outDir": "dist",
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "types": ["react", "node"]
  },
  "include": ["src", "App.tsx", "index.ts"]
}
