# Copy to .env.local for local web development (Expo auto-loads it).
# URL of services/api (see apps/admin-web/.env.local for the same value).
# Defaults to http://10.0.2.2:3000 if unset, which only resolves from inside
# the Android emulator (it's the emulator's alias for the host machine) — use
# this to point the web build at the API running on your actual localhost.
EXPO_PUBLIC_API_URL=http://localhost:3001
