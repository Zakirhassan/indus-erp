{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "apps/*/src",
    "packages/*/src",
    "services/*/src",
    "scripts"
  ],
  "exclude": ["node_modules", "dist", "build", "**/dist", "**/build"]
}
